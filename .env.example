# Required — app will not authenticate or persist without these
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required for live Section 05 AI assist (dev-only mock if unset)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — diagnostic result email (skipped with a log if unset)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=The Bench Blueprint <hello@example.com>

# Optional — public site origin used in email links (defaults to Vercel URL or localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — funnel analytics (ignored if unset; never captures workbook text)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
